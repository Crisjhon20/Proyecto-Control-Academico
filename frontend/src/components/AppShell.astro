---
import BrandMark from './BrandMark.astro'
import NavIcon from './NavIcon.astro'
const { active = 'inicio' } = Astro.props
const links = [
  ['inicio', 'Inicio', '/app/', 'home'],
  ['malla', 'Malla curricular', '/app/malla', 'curriculum'],
  ['inscripciones', 'Inscripciones', '/app/inscripciones', 'enrollments'],
  ['horario', 'Mi horario', '/app/horario', 'schedule'],
  ['historial', 'Historial', '/app/historial', 'history'],
  ['notas', 'Notas', '/app/notas', 'notes'],
]
---
<div class="min-h-screen bg-[#102431]">
  <header class="sticky top-0 z-30 border-b border-[#294552] bg-[#0d1b28]/95">
    <div class="mx-auto flex max-w-[1500px] items-center justify-between px-5 py-3 lg:px-10">
      <a href="/app/" class="focus-ring flex items-center gap-3">
        <BrandMark />
        <span class="hidden leading-tight sm:block"><strong class="block text-sm text-[#e9f1f4]">Control Académico</strong><small class="text-[.65rem] tracking-[.13em] text-[#8fa9b5]">INGENIERÍA EN SISTEMAS</small></span>
      </a>
      <div class="flex items-center gap-3">
        <span id="shell-student" class="hidden text-right text-xs text-[#9db2bd] sm:block"></span>
        <a href="/app/perfil" class="focus-ring grid h-9 w-9 place-items-center overflow-hidden rounded-full border border-[#427487] bg-[#193b4b] text-xs font-bold text-[#8ed2eb]" id="shell-avatar" aria-label="Abrir perfil"><span id="shell-avatar-fallback">CA</span><img id="shell-avatar-image" class="hidden h-full w-full object-cover" alt="" /></a>
        <button id="menu-toggle" class="focus-ring rounded-lg border border-[#2a4a59] px-3 py-2 text-[#8ed2eb] md:hidden" aria-label="Abrir menú">☰</button>
      </div>
    </div>
  </header>
  <div class="mx-auto flex max-w-[1500px] items-stretch">
    <aside id="app-sidebar" class="fixed inset-y-[65px] left-0 z-20 hidden w-64 border-r border-[#294552] bg-[#0e1d29] px-4 pb-6 pt-6 transition-[width] duration-200 md:sticky md:top-[65px] md:block md:h-[calc(100vh-65px)] md:self-start">
      <div class="mb-4 flex items-center justify-between px-3">
        <p id="sidebar-title" class="text-[.65rem] font-extrabold uppercase tracking-[.15em] text-[#5d8494]">Tu espacio</p>
        <button id="sidebar-collapse" class="focus-ring hidden rounded-md p-1 text-[#73b8d5] transition hover:bg-[#193b4b] md:block" type="button" aria-label="Colapsar menú" aria-expanded="true" title="Colapsar menú"><span aria-hidden="true">‹</span></button>
      </div>
      <nav class="space-y-1">
        {links.map(([key, label, href, icon]) => <a href={href} title={label} class:list={["focus-ring nav-link group flex items-center justify-between gap-3 rounded-lg px-3 py-3 text-sm transition", active === key ? "bg-[#193b4b] text-[#8ed2eb]" : "text-[#a9bbc5] hover:bg-[#142d3a] hover:text-[#e9f1f4]"]}><span class="nav-icon"><NavIcon name={icon} /></span><span class="nav-label min-w-0 flex-1">{label}</span><span class="nav-arrow text-[#5f8797] transition group-hover:translate-x-1">→</span></a>)}
      </nav>
      <div class="absolute inset-x-4 bottom-6 border-t border-[#294552] pt-5">
        <a href="/app/companeros" title="Compañeros por materia" class="nav-link flex items-center gap-3 rounded-lg px-3 py-3 text-sm text-[#a9bbc5] transition hover:bg-[#142d3a] hover:text-[#e9f1f4]"><span class="nav-icon"><NavIcon name="users" /></span><span class="nav-label">Compañeros por materia</span></a>
        <button id="logout-button" class="nav-link mt-2 flex w-full items-center gap-3 rounded-lg px-3 py-3 text-left text-sm text-[#ef9a9a] transition hover:bg-[#301f28]"><span class="nav-icon"><NavIcon name="logout" /></span><span class="nav-label">Cerrar sesión</span></button>
      </div>
    </aside>
    <main class="min-w-0 flex-1 px-5 py-8 lg:px-12 lg:py-10"><slot /></main>
  </div>
</div>
<script>
  import { getSession, clearSession } from '../lib/session'
  import { api } from '../lib/api'
  const session = getSession()
  const name = document.querySelector('#shell-student')
  const avatar = document.querySelector('#shell-avatar-fallback')
  const avatarImage = document.querySelector<HTMLImageElement>('#shell-avatar-image')
  if (session) {
    const full = `${session.student.nombres} ${session.student.apellidos}`
    if (name) name.textContent = full
    if (avatar) avatar.textContent = session.student.nombres.slice(0, 1) + session.student.apellidos.slice(0, 1)
    api.profilePhoto().then((blob) => {
      if (!avatarImage) return
      avatarImage.src = URL.createObjectURL(blob)
      avatarImage.classList.remove('hidden')
      avatar?.classList.add('hidden')
    }).catch(() => {})
  } else window.location.href = '/login'
  document.querySelector('#logout-button')?.addEventListener('click', async () => {
    try { await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api'}/auth/logout`, { method: 'POST', headers: { Authorization: `Bearer ${session?.token}` } }) } catch {}
    clearSession(); window.location.href = '/login'
  })
  document.querySelector('#menu-toggle')?.addEventListener('click', () => document.querySelector('#app-sidebar')?.classList.toggle('hidden'))

  const sidebar = document.querySelector<HTMLElement>('#app-sidebar')
  const collapseButton = document.querySelector<HTMLButtonElement>('#sidebar-collapse')
  const sidebarStorageKey = 'control-academico.sidebar-collapsed'
  const setSidebarCollapsed = (collapsed: boolean) => {
    sidebar?.classList.toggle('sidebar-collapsed', collapsed)
    collapseButton?.setAttribute('aria-expanded', String(!collapsed))
    collapseButton?.setAttribute('aria-label', collapsed ? 'Expandir menú' : 'Colapsar menú')
    collapseButton?.setAttribute('title', collapsed ? 'Expandir menú' : 'Colapsar menú')
    if (collapseButton) collapseButton.innerHTML = collapsed ? '<span aria-hidden="true">›</span>' : '<span aria-hidden="true">‹</span>'
  }
  if (localStorage.getItem(sidebarStorageKey) === 'true') setSidebarCollapsed(true)
  collapseButton?.addEventListener('click', () => {
    const collapsed = !sidebar?.classList.contains('sidebar-collapsed')
    setSidebarCollapsed(collapsed)
    localStorage.setItem(sidebarStorageKey, String(collapsed))
  })
</script>
