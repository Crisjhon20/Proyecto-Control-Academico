---
const { name } = Astro.props
---
<svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && <><path d="m3 10 9-7 9 7" /><path d="M5 9v11h14V9" /><path d="M9 20v-6h6v6" /></>}
  {name === 'curriculum' && <><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></>}
  {name === 'enrollments' && <><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Z" /><path d="M8 17h11" /><path d="M12 8v5M9.5 10.5h5" /></>}
  {name === 'schedule' && <><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /><path d="M8 14h3M13 14h3M8 17h3" /></>}
  {name === 'history' && <><path d="M4 7h16v13H4z" /><path d="M8 4h8v3H8zM8 11h8M8 15h5" /></>}
  {name === 'notes' && <><path d="M5 3h10l4 4v14H5z" /><path d="M15 3v5h4M8 12h8M8 16h6" /></>}
  {name === 'users' && <><circle cx="9" cy="8" r="3" /><path d="M3 20c0-3 2.7-5 6-5s6 2 6 5" /><path d="M16 5.5a3 3 0 0 1 0 5.8M18 15c1.8.7 3 2.4 3 5" /></>}
  {name === 'logout' && <><path d="M10 4H5v16h5" /><path d="m14 8 4 4-4 4M8 12h10" /></>}
</svg>
