---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Inscripciones | Control Académico" active="inscripciones">
  <span class="eyebrow">Gestión personal</span>
  <h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tus materias<br /><span class="text-[#70b6d4]">inscritas.</span></h1>
  <p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Registra y retira materias para construir el periodo que realmente estás cursando.</p>
  <div class="mt-10 flex flex-wrap items-end gap-3"><label class="text-sm text-[#a9bbc5]">Periodo<select id="period-select" class="input-field mt-2 min-w-52"></select></label><button id="reload" class="btn-secondary">Actualizar ↻</button><button id="close-period" class="btn-secondary">Cerrar periodo</button><button id="new-period" class="btn-primary">Crear periodo</button></div>
  <p id="enrollment-feedback" class="mt-5 hidden rounded-xl border p-4 text-sm"></p>
  <div class="mt-8 grid gap-6 xl:grid-cols-2"><section class="surface rounded-2xl p-6"><div class="flex items-end justify-between"><div><span class="eyebrow">Tu carga</span><h2 class="mt-4 text-2xl font-bold">Materias inscritas</h2></div><span id="enrolled-count" class="text-sm text-[#8fa9b5]"></span></div><div id="enrolled" class="mt-6 space-y-3"></div></section><section class="surface rounded-2xl p-6"><span class="eyebrow">Disponible</span><h2 class="mt-4 text-2xl font-bold">Agregar materia</h2><div id="available" class="mt-6 space-y-3"></div></section></div>
</AppLayout>
<dialog id="period-dialog" class="m-auto w-[min(92vw,460px)] rounded-2xl border border-[#315667] bg-[#102431] p-0 text-[#e9f1f4] backdrop:bg-[#061018]/80"><form id="period-form" class="p-6"><div class="flex items-center justify-between"><div><span class="eyebrow">Nuevo ciclo</span><h2 class="mt-4 text-2xl font-bold">Crear periodo personal</h2></div><button type="button" id="period-close" class="text-2xl text-[#8fa9b5]" aria-label="Cerrar">×</button></div><div class="mt-6 grid gap-4"><label class="text-sm text-[#a9bbc5]">Nombre<input class="input-field mt-2" name="nombre" placeholder="2027-I" pattern="[0-9]{4}-(I|II)" required /></label><label class="text-sm text-[#a9bbc5]">Fecha de inicio<input class="input-field mt-2" name="fechaInicio" type="date" /></label><label class="text-sm text-[#a9bbc5]">Fecha de finalización<input class="input-field mt-2" name="fechaFin" type="date" /></label><button class="btn-primary mt-2" type="submit">Crear periodo</button></div></form></dialog>
<script>
  import { api, ApiError } from '../../lib/api'
  import { requireSession } from '../../lib/session'

  requireSession()

  const periodSelect = document.querySelector<HTMLSelectElement>('#period-select')!
  const enrolledRoot = document.querySelector('#enrolled')!
  const availableRoot = document.querySelector('#available')!
  const feedback = document.querySelector('#enrollment-feedback')!
  const closePeriodButton = document.querySelector<HTMLButtonElement>('#close-period')!
  const periodDialog = document.querySelector<HTMLDialogElement>('#period-dialog')!
  const periodForm = document.querySelector<HTMLFormElement>('#period-form')!
  let periodId = 0

  function message(text: string, bad = false) {
    feedback.textContent = text
    feedback.className = `mt-5 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}`
  }

  function bindActions() {
    document.querySelectorAll<HTMLElement>('[data-withdraw]').forEach((button) => {
      button.onclick = async () => {
        try {
          await api.withdraw(Number(button.dataset.withdraw))
          message('Materia retirada correctamente.')
          await render()
        } catch (error) {
          message(error instanceof ApiError ? error.message : 'No se pudo retirar la materia', true)
        }
      }
    })

    document.querySelectorAll<HTMLElement>('[data-enroll]').forEach((button) => {
      button.onclick = async () => {
        try {
          await api.enroll({ materiaId: Number(button.dataset.enroll), periodoAcademicoId: periodId })
          message('Materia inscrita correctamente.')
          await render()
        } catch (error) {
          message(error instanceof ApiError ? error.message : 'No se pudo inscribir la materia', true)
        }
      }
    })
  }

  async function render() {
    const [enrolled, periods]: any[] = await Promise.all([api.enrollments(periodId), api.periods()])
    const selectedPeriod = periods.find((period: any) => period.id === periodId)
    const activeEnrollments = enrolled.filter((item: any) => item.estado === 'Inscrita')

    document.querySelector('#enrolled-count')!.textContent = `${activeEnrollments.length} activas`
    enrolledRoot.innerHTML = enrolled.length
      ? enrolled.map((item: any) => `<article class="surface-soft flex items-center justify-between gap-4 rounded-xl p-4"><div><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${item.codigo}</span><h3 class="mt-1 font-semibold">${item.materia}</h3><p class="mt-1 text-xs text-[#8fa9b5]">${item.periodo} · Semestre ${item.semestre} · ${item.creditos} créditos · ${item.estado}</p></div>${item.estado === 'Inscrita' && !selectedPeriod?.cerrado ? `<button data-withdraw="${item.id}" class="btn-danger text-sm">Retirar</button>` : ''}</article>`).join('')
      : '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">No hay materias inscritas en este periodo.</p>'

    if (selectedPeriod?.cerrado) {
      availableRoot.innerHTML = '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">Este periodo está cerrado y no admite nuevas inscripciones.</p>'
      bindActions()
      return
    }

    const available: any[] = await api.availableSubjects(periodId) as any[]
    availableRoot.innerHTML = available.length
      ? available.map((item: any) => `<article class="surface-soft flex flex-col gap-4 rounded-xl p-4 sm:flex-row sm:items-end sm:justify-between"><div><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${item.codigo}</span><h3 class="mt-1 font-semibold">${item.nombre}</h3><p class="mt-1 text-xs text-[#8fa9b5]">Semestre ${item.semestre} · ${item.creditos || 5} créditos</p></div><button data-enroll="${item.id}" class="btn-primary px-3 py-2 text-xs">Inscribir</button></article>`).join('')
      : '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">No hay materias disponibles.</p>'
    bindActions()
  }

  async function load() {
    try {
      const [periods, current]: any[] = await Promise.all([api.periods(), api.currentPeriod()])
      periodSelect.innerHTML = periods.map((period: any) => `<option value="${period.id}" ${period.id === current?.id ? 'selected' : ''}>${period.nombre}${period.cerrado ? ' · cerrado' : ''}</option>`).join('')
      periodId = Number(periodSelect.value)
      closePeriodButton.disabled = !current || periodId !== current.id
      if (periodId) await render()
      else message('Crea tu primer periodo para comenzar.', false)
    } catch (error) {
      message(error instanceof Error ? error.message : 'No se pudo cargar la información', true)
    }
  }

  periodSelect.onchange = () => {
    periodId = Number(periodSelect.value)
    render().catch((error) => message(error.message, true))
  }

  document.querySelector('#reload')?.addEventListener('click', () => render())
  document.querySelector('#new-period')?.addEventListener('click', () => periodDialog.showModal())
  document.querySelector('#period-close')?.addEventListener('click', () => periodDialog.close())
  closePeriodButton.addEventListener('click', async () => {
    if (!periodId || !confirm('¿Cerrar tu periodo activo? Esta acción archivará sus resultados.')) return
    try {
      await api.closePeriod(periodId)
      message('Periodo cerrado correctamente.')
      await load()
    } catch (error) {
      message(error instanceof ApiError ? error.message : 'No se pudo cerrar el periodo', true)
    }
  })
  periodForm.addEventListener('submit', async (event) => {
    event.preventDefault()
    const data = Object.fromEntries(new FormData(periodForm).entries()) as { nombre: string; fechaInicio?: string; fechaFin?: string }
    if (!data.fechaInicio) delete data.fechaInicio
    if (!data.fechaFin) delete data.fechaFin
    try {
      await api.createPeriod(data)
      periodDialog.close()
      periodForm.reset()
      message('Periodo creado correctamente.')
      await load()
    } catch (error) {
      message(error instanceof ApiError ? error.message : 'No se pudo crear el periodo', true)
    }
  })
  load()
</script>
