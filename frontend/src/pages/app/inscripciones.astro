---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Inscripciones | Control Académico" active="inscripciones">
  <span class="eyebrow">Gestión personal</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tus materias<br /><span class="text-[#70b6d4]">inscritas.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Registra y retira materias para construir el periodo que realmente estás cursando.</p>
  <div class="mt-10 flex flex-wrap items-end gap-3"><label class="text-sm text-[#a9bbc5]">Periodo<select id="period-select" class="input-field mt-2 min-w-52"></select></label><button id="reload" class="btn-secondary">Actualizar ↻</button></div>
  <p id="enrollment-feedback" class="mt-5 hidden rounded-xl border p-4 text-sm"></p>
  <div class="mt-8 grid gap-6 xl:grid-cols-2"><section class="surface rounded-2xl p-6"><div class="flex items-end justify-between"><div><span class="eyebrow">Tu carga</span><h2 class="mt-4 text-2xl font-bold">Materias inscritas</h2></div><span id="enrolled-count" class="text-sm text-[#8fa9b5]"></span></div><div id="enrolled" class="mt-6 space-y-3"></div></section><section class="surface rounded-2xl p-6"><span class="eyebrow">Disponible</span><h2 class="mt-4 text-2xl font-bold">Agregar materia</h2><div id="available" class="mt-6 space-y-3"></div></section></div>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { requireSession } from '../../lib/session'; requireSession()
  const periodSelect = document.querySelector<HTMLSelectElement>('#period-select')!; const enrolledRoot = document.querySelector('#enrolled')!; const availableRoot = document.querySelector('#available')!; const feedback = document.querySelector('#enrollment-feedback')!; let periodId = 0
  function message(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-5 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  async function load() { try { const [periods, current]: any[] = await Promise.all([api.periods(), api.currentPeriod()]); periodSelect.innerHTML = periods.map((p: any) => `<option value="${p.id}" ${p.id === current.id ? 'selected' : ''}>${p.nombre}${p.cerrado ? ' · cerrado' : ''}</option>`).join(''); periodId = Number(periodSelect.value); await render() } catch (e) { message(e instanceof Error ? e.message : 'No se pudo cargar la información', true) } }
  async function render() { const [enrolled, available]: any[] = await Promise.all([api.enrollments(periodId), api.availableSubjects(periodId)]); const current = enrolled.filter((item: any) => item.estado === 'Inscrita'); document.querySelector('#enrolled-count')!.textContent = `${current.length} activas`; enrolledRoot.innerHTML = enrolled.length ? enrolled.map((item: any) => `<article class="surface-soft flex items-center justify-between gap-4 rounded-xl p-4"><div><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${item.codigo}</span><h3 class="mt-1 font-semibold">${item.materia}</h3><p class="mt-1 text-xs text-[#8fa9b5]">${item.periodo} · ${item.creditos} créditos · ${item.estado}</p></div>${item.estado === 'Inscrita' ? `<button data-withdraw="${item.id}" class="btn-danger text-sm">Retirar</button>` : ''}</article>`).join('') : '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">No hay materias inscritas en este periodo.</p>'; availableRoot.innerHTML = available.length ? available.map((item: any) => `<article class="surface-soft flex items-center justify-between gap-4 rounded-xl p-4"><div><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${item.codigo}</span><h3 class="mt-1 font-semibold">${item.nombre}</h3><p class="mt-1 text-xs text-[#8fa9b5]">Semestre ${item.semestre} · ${item.creditos || 5} créditos</p></div><button data-enroll="${item.id}" class="btn-primary px-3 py-2 text-xs">Inscribir</button></article>`).join('') : '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">No hay materias disponibles.</p>'; bindActions() }
  function bindActions() { document.querySelectorAll<HTMLElement>('[data-withdraw]').forEach(button => button.onclick = async () => { try { await api.withdraw(Number(button.dataset.withdraw)); message('Materia retirada correctamente.'); await render() } catch (e) { message(e instanceof ApiError ? e.message : 'No se pudo retirar la materia', true) } }); document.querySelectorAll<HTMLElement>('[data-enroll]').forEach(button => button.onclick = async () => { try { const semestre = Number(button.closest('article')?.querySelector('p')?.textContent.match(/Semestre (\d+)/)?.[1] || 1); await api.enroll({ materiaId: Number(button.dataset.enroll), periodoAcademicoId: periodId, semestreCursado: semestre }); message('Materia inscrita correctamente.'); await render() } catch (e) { message(e instanceof ApiError ? e.message : 'No se pudo inscribir la materia', true) } }) }
  periodSelect.onchange = () => { periodId = Number(periodSelect.value); render().catch(e => message(e.message, true)) }; document.querySelector('#reload')?.addEventListener('click', () => render()); load()
</script>
