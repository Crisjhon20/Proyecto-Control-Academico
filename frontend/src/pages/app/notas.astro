---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Gestión de notas | Control Académico" active="notas">
  <span class="eyebrow">Gestión personal</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Gestiona tus<br /><span class="text-[#70b6d4]">notas.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Configura las evaluaciones de cada materia, registra tus notas y consulta cuánto necesitas para alcanzar 51 puntos.</p>
  <p id="grades-feedback" class="mt-6 hidden rounded-xl border p-4 text-sm"></p>
  <div id="subjects" class="mt-8 grid gap-6 xl:grid-cols-2"></div>
</AppLayout>
<script>
  import { api } from '../../lib/api'; import { requireSession } from '../../lib/session'; import { z } from 'zod'; requireSession()
  const root = document.querySelector('#subjects')!; const feedback = document.querySelector('#grades-feedback')!
  const formSchema = z.object({ evaluaciones: z.array(z.object({ nombre: z.string().trim().min(1).max(80), porcentaje: z.number().positive().max(100), nota: z.number().min(0).max(100).optional() })).min(1) }).superRefine((value, context) => { const names = value.evaluaciones.map(item => item.nombre.toLocaleLowerCase()); if (new Set(names).size !== names.length) context.addIssue({ code: 'custom', path: ['evaluaciones'], message: 'No repitas el nombre de una evaluación' }); const sum = value.evaluaciones.reduce((total, item) => total + item.porcentaje, 0); if (Math.round(sum * 100) !== 10000) context.addIssue({ code: 'custom', path: ['evaluaciones'], message: 'La ponderación total debe ser exactamente 100%' }) })
  function showMessage(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-6 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  function updateSummary(section: HTMLElement) { const rows = [...section.querySelectorAll<HTMLElement>('.evaluation-row')]; const total = rows.reduce((sum, row) => sum + Number((row.querySelector('.evaluation-weight') as HTMLInputElement).value || 0), 0); const current = rows.reduce((sum, row) => { const grade = (row.querySelector('.evaluation-grade') as HTMLInputElement).value; return sum + (grade === '' ? 0 : Number(grade) * Number((row.querySelector('.evaluation-weight') as HTMLInputElement).value || 0) / 100) }, 0); const missing = Math.max(0, 51 - current); section.querySelector('[data-total]')!.textContent = `${total.toFixed(2).replace('.00', '')}%`; section.querySelector('[data-current]')!.textContent = `${current.toFixed(2)} / 100`; section.querySelector('[data-missing]')!.textContent = missing === 0 ? 'Aprobativa' : `${missing.toFixed(2)} puntos` }
  function addRow(rows: HTMLElement, item: any = {}) { const row = document.createElement('div'); row.className = 'evaluation-row grid gap-3 rounded-xl border border-[#315667] bg-[#193746] p-4 md:grid-cols-[1.4fr_.6fr_.6fr_auto] md:items-end'; row.innerHTML = `<label class="text-sm text-[#a9bbc5]">Evaluación<input class="input-field mt-2 evaluation-name" value="${item.nombre || ''}" placeholder="Ej. Primer Parcial" required /></label><label class="text-sm text-[#a9bbc5]">Ponderación<input class="input-field mt-2 evaluation-weight" type="number" min="0.01" max="100" step="0.01" value="${item.porcentaje ?? ''}" placeholder="20" required /></label><label class="text-sm text-[#a9bbc5]">Nota<input class="input-field mt-2 evaluation-grade" type="number" min="0" max="100" step="0.01" value="${item.nota ?? ''}" placeholder="Pendiente" /></label><button type="button" class="remove-row btn-danger px-2 py-2 text-sm">Quitar</button>`; row.querySelector('.remove-row')?.addEventListener('click', () => { row.remove(); updateSummary(rows.closest('details')!) }); row.querySelectorAll('input').forEach(input => input.addEventListener('input', () => updateSummary(rows.closest('details')!))); rows.append(row) }
  function values(section: HTMLElement) { return [...section.querySelectorAll<HTMLElement>('.evaluation-row')].map(row => { const nota = (row.querySelector('.evaluation-grade') as HTMLInputElement).value; return { nombre: (row.querySelector('.evaluation-name') as HTMLInputElement).value, porcentaje: Number((row.querySelector('.evaluation-weight') as HTMLInputElement).value), ...(nota === '' ? {} : { nota: Number(nota) }) } }) }
  function renderSubject(enrollment: any, evaluations: any[]) { const section = document.createElement('section'); section.className = 'surface overflow-hidden rounded-2xl'; section.innerHTML = `<details><summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6"><div><span class="eyebrow">${enrollment.codigo}</span><h2 class="mt-3 text-2xl font-bold">${enrollment.materia}</h2><p class="mt-2 text-xs text-[#8fa9b5]">${enrollment.periodo} · Semestre cursado ${enrollment.semestre_cursado}</p><p class="details-closed-hint mt-3 text-xs text-[#73b8d5]">Presiona para abrir el apartado.</p><p class="details-open-hint mt-3 text-xs text-[#73b8d5]">Presiona para cerrar el apartado.</p></div><span class="text-sm text-[#73b8d5]">Notas</span></summary><div class="border-t border-[#315667] p-6"><div class="flex flex-wrap gap-4 rounded-xl border border-[#315667] bg-[#193746] p-4 text-sm"><span>Nota acumulada: <strong data-current class="text-[#8ed8c9]">0 / 100</strong></span><span>Ponderación: <strong data-total class="text-[#73b8d5]">0%</strong></span><span>Falta para aprobar: <strong data-missing class="text-[#f0d18b]">51 puntos</strong></span></div><form class="grades-form mt-6"><div class="evaluation-rows space-y-3"></div><div class="mt-5 flex flex-wrap gap-3"><button type="button" class="add-evaluation btn-secondary">+ Agregar evaluación</button><button type="submit" class="btn-primary">Guardar notas ↗</button></div></form></div></details>`; const details = section.querySelector('details')!; const rows = section.querySelector('.evaluation-rows') as HTMLElement; (evaluations.length ? evaluations : [{}]).forEach(item => addRow(rows, item)); section.querySelector('.add-evaluation')?.addEventListener('click', () => addRow(rows)); section.querySelector('form')?.addEventListener('submit', async event => { event.preventDefault(); const parsed = formSchema.safeParse({ evaluaciones: values(section) }); if (!parsed.success) { showMessage(parsed.error.issues[0]?.message || 'Revisa las evaluaciones', true); return } try { await api.saveEvaluations(enrollment.id, parsed.data); showMessage(`Notas de ${enrollment.materia} guardadas correctamente.`); const updated: any[] = await api.evaluations(enrollment.id) as any[]; rows.innerHTML = ''; updated.forEach(item => addRow(rows, item)); updateSummary(details) } catch (error) { showMessage(error instanceof Error ? error.message : 'No se pudieron guardar las notas', true) } }); root.append(section); updateSummary(details) }
  async function load() { try { const enrollments: any[] = await api.enrollments(); const active = enrollments.filter(item => item.estado === 'Inscrita'); if (!active.length) { root.innerHTML = '<p class="text-sm text-[#8fa9b5]">No tienes materias inscritas abiertas.</p>'; return } const evaluations = await Promise.all(active.map(item => api.evaluations(item.id))); active.forEach((item, index) => renderSubject(item, evaluations[index] as any[])) } finally { ;(window as any).hidePageLoading?.() } }
  load().catch(() => { showMessage('No se pudieron cargar tus materias', true); (window as any).hidePageLoading?.() })
</script>
