---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Gestión de notas | Control Académico" active="notas">
  <span class="eyebrow">Gestión personal</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Gestiona tus<br /><span class="text-[#70b6d4]">notas.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Define cómo se pondera cada materia y registra tus resultados. La suma debe completar exactamente el 100%.</p>
  <div class="mt-10 max-w-xl"><label class="text-sm text-[#a9bbc5]">Materia inscrita<select id="enrollment-select" class="input-field mt-2"></select></label></div>
  <p id="grades-feedback" class="mt-6 hidden rounded-xl border p-4 text-sm"></p>
  <section class="surface mt-8 max-w-4xl rounded-2xl p-6 sm:p-8"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><span class="eyebrow">Ponderación</span><h2 class="mt-4 text-2xl font-bold">Evaluaciones de la materia</h2></div><div class="text-left sm:text-right"><span class="block text-xs uppercase tracking-[.12em] text-[#7897a4]">Total configurado</span><strong id="total-weight" class="mt-1 block text-3xl text-[#73b8d5]">0%</strong></div></div><form id="grades-form" class="mt-8"><div id="evaluation-rows" class="space-y-3"></div><div class="mt-5 flex flex-wrap gap-3"><button type="button" id="add-evaluation" class="btn-secondary">+ Agregar evaluación</button><button type="submit" class="btn-primary">Guardar configuración ↗</button></div></form></section>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { requireSession } from '../../lib/session'; import { z } from 'zod'; requireSession()
  const select = document.querySelector<HTMLSelectElement>('#enrollment-select')!; const rowsRoot = document.querySelector('#evaluation-rows')!; const total = document.querySelector('#total-weight')!; const feedback = document.querySelector('#grades-feedback')!; let selected = 0
  const formSchema = z.object({ evaluaciones: z.array(z.object({ nombre: z.string().trim().min(1).max(80), porcentaje: z.number().positive().max(100), nota: z.number().min(0).max(100).optional() })).min(1) }).superRefine((value, context) => { const names = value.evaluaciones.map(item => item.nombre.toLocaleLowerCase()); if (new Set(names).size !== names.length) context.addIssue({ code: 'custom', path: ['evaluaciones'], message: 'No repitas el nombre de una evaluación' }); const sum = value.evaluaciones.reduce((total, item) => total + item.porcentaje, 0); if (Math.round(sum * 100) !== 10000) context.addIssue({ code: 'custom', path: ['evaluaciones'], message: 'La ponderación total debe ser exactamente 100%' }) })
  function showMessage(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-6 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  function addRow(item: any = {}) { const row = document.createElement('div'); row.className = 'evaluation-row grid gap-3 rounded-xl border border-[#315667] bg-[#193746] p-4 md:grid-cols-[1.5fr_.65fr_.65fr_auto] md:items-end'; row.innerHTML = `<label class="text-sm text-[#a9bbc5]">Evaluación<input class="input-field mt-2 evaluation-name" value="${item.nombre || ''}" placeholder="Ej. Primer Parcial" required /></label><label class="text-sm text-[#a9bbc5]">Porcentaje<input class="input-field mt-2 evaluation-weight" type="number" min="0.01" max="100" step="0.01" value="${item.porcentaje ?? ''}" placeholder="20" required /></label><label class="text-sm text-[#a9bbc5]">Nota<input class="input-field mt-2 evaluation-grade" type="number" min="0" max="100" step="0.01" value="${item.nota ?? ''}" placeholder="Pendiente" /></label><button type="button" class="remove-row btn-danger px-2 py-2 text-sm">Quitar</button>`; row.querySelector('.remove-row')?.addEventListener('click', () => { row.remove(); updateTotal() }); row.querySelectorAll('input').forEach(input => input.addEventListener('input', updateTotal)); rowsRoot.append(row); updateTotal() }
  function updateTotal() { const weights = [...document.querySelectorAll<HTMLInputElement>('.evaluation-weight')].reduce((sum, input) => sum + Number(input.value || 0), 0); total.textContent = `${weights.toFixed(2).replace('.00', '')}%`; total.className = `mt-1 block text-3xl ${Math.round(weights * 100) === 10000 ? 'text-[#8ed8c9]' : 'text-[#73b8d5]'}` }
  async function loadEvaluations() { const items: any[] = await api.evaluations(selected) as any[]; rowsRoot.innerHTML = ''; items.forEach(addRow); if (!items.length) addRow(); updateTotal() }
  async function load() { const enrollments: any[] = await api.enrollments() as any[]; const active = enrollments.filter(item => item.estado === 'Inscrita'); select.innerHTML = active.map(item => `<option value="${item.id}">${item.codigo} · ${item.materia}</option>`).join(''); if (!active.length) { rowsRoot.innerHTML = '<p class="text-sm text-[#8fa9b5]">No tienes materias inscritas abiertas.</p>'; return }; selected = Number(select.value); await loadEvaluations() }
  select.addEventListener('change', () => { selected = Number(select.value); loadEvaluations().catch(() => showMessage('No se pudieron cargar las evaluaciones', true)) }); document.querySelector('#add-evaluation')?.addEventListener('click', () => addRow()); document.querySelector('#grades-form')?.addEventListener('submit', async event => { event.preventDefault(); const evaluaciones = [...document.querySelectorAll<HTMLElement>('.evaluation-row')].map(row => { const nota = (row.querySelector('.evaluation-grade') as HTMLInputElement).value; return { nombre: (row.querySelector('.evaluation-name') as HTMLInputElement).value, porcentaje: Number((row.querySelector('.evaluation-weight') as HTMLInputElement).value), ...(nota === '' ? {} : { nota: Number(nota) }) } }); const parsed = formSchema.safeParse({ evaluaciones }); if (!parsed.success) { showMessage(parsed.error.issues[0]?.message || 'Revisa las evaluaciones', true); return } try { await api.saveEvaluations(selected, parsed.data); showMessage('Configuración y notas guardadas correctamente.'); await loadEvaluations() } catch (error) { showMessage(error instanceof ApiError ? error.message : 'No se pudieron guardar las notas', true) } }); load().catch(() => showMessage('No se pudieron cargar tus materias', true))
</script>
