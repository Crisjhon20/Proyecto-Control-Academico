---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Asistencia | Control Académico" active="asistencia">
  <span class="eyebrow">Seguimiento</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu asistencia<br /><span class="text-[#70b6d4]">clase a clase.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Revisa tus registros y observa cómo avanza tu porcentaje por materia.</p><div id="summary" class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div><section class="surface mt-8 overflow-hidden rounded-2xl"><div class="border-b border-[#315667] p-6"><span class="eyebrow">Registro detallado</span><h2 class="mt-4 text-2xl font-bold">Últimas clases</h2></div><div id="attendance" class="divide-y divide-[#294b5a]"></div></section>
</AppLayout>
<script>
  import { api } from '../../lib/api'; import { requireSession } from '../../lib/session'; requireSession(); const summaryRoot = document.querySelector('#summary')!; const attendanceRoot = document.querySelector('#attendance')!
  try { const [summary, attendance]: any[] = await Promise.all([api.attendanceSummary(), api.attendance()]); summaryRoot.innerHTML = summary.length ? summary.map((row: any) => `<article class="surface rounded-2xl p-6"><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${row.codigo}</span><h2 class="mt-2 text-lg font-bold">${row.materia}</h2><div class="mt-5 flex items-end justify-between"><strong class="text-4xl text-[#e9f1f4]">${row.porcentaje}%</strong><span class="text-xs text-[#8fa9b5]">${row.asistencias}/${row.total} asistencias</span></div><div class="mt-4 h-2 rounded-full bg-[#1e4050]"><div class="h-full rounded-full bg-[#73b8d5]" style="width:${row.porcentaje}%"></div></div></article>`).join('') : '<p class="text-sm text-[#8fa9b5]">Aún no hay resumen de asistencia.</p>'; attendanceRoot.innerHTML = attendance.length ? attendance.map((row: any) => `<div class="flex items-center justify-between gap-4 px-6 py-4"><div><strong class="block text-sm">${row.materia}</strong><span class="text-xs text-[#8fa9b5]">${row.fecha_clase.slice(0,10)} · ${row.periodo}</span></div><span class="rounded-full px-3 py-1 text-xs ${row.estado === 'Asistió' ? 'bg-[#1b4a48] text-[#98ded0]' : 'bg-[#4b2933] text-[#f0aaaa]'}">${row.estado}</span></div>`).join('') : '<p class="p-6 text-sm text-[#8fa9b5]">No hay registros de asistencia.</p>' } catch { summaryRoot.innerHTML = '<p class="text-sm text-[#efaaaa]">No se pudo cargar la asistencia.</p>' }
</script>
