---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Asistencia | Control Académico" active="asistencia">
  <span class="eyebrow">Seguimiento</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu asistencia<br /><span class="text-[#70b6d4]">clase a clase.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Registra tu asistencia con fecha y consulta el avance separado por materia y horario semanal.</p>
  <p id="attendance-feedback" class="mt-6 hidden rounded-xl border p-4 text-sm"></p>
  <section class="surface mt-8 rounded-2xl p-6"><span class="eyebrow">Nuevo registro</span><h2 class="mt-4 text-2xl font-bold">Registrar asistencia</h2><form id="attendance-form" class="mt-6 grid gap-4 md:grid-cols-[1fr_180px_180px_auto] md:items-end"><label class="text-sm text-[#a9bbc5]">Materia<select id="attendance-enrollment" class="input-field mt-2" required></select></label><label class="text-sm text-[#a9bbc5]">Fecha<input id="attendance-date" class="input-field mt-2" type="date" required /></label><label class="text-sm text-[#a9bbc5]">Estado<select id="attendance-status" class="input-field mt-2"><option>Asistió</option><option>Faltó</option></select></label><button class="btn-primary" type="submit">Guardar asistencia</button></form><p class="mt-4 text-xs text-[#8fa9b5]">La fecha debe corresponder a uno de los días configurados en el horario de la materia.</p></section>
  <div id="summary" class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
  <section class="surface mt-8 overflow-hidden rounded-2xl"><div class="border-b border-[#315667] p-6"><span class="eyebrow">Horarios semanales</span><h2 class="mt-4 text-2xl font-bold">Materias y días de clase</h2></div><div id="weekly" class="grid gap-4 p-6 md:grid-cols-2"></div></section>
  <section class="surface mt-8 overflow-hidden rounded-2xl"><div class="border-b border-[#315667] p-6"><span class="eyebrow">Registro detallado</span><h2 class="mt-4 text-2xl font-bold">Asistencias registradas</h2></div><div id="attendance" class="divide-y divide-[#294b5a]"></div></section>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { requireSession } from '../../lib/session'; requireSession(); const summaryRoot = document.querySelector('#summary')!; const attendanceRoot = document.querySelector('#attendance')!; const weeklyRoot = document.querySelector('#weekly')!; const select = document.querySelector<HTMLSelectElement>('#attendance-enrollment')!; const feedback = document.querySelector('#attendance-feedback')!
  function message(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-6 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  async function load() { const [summary, attendance, enrollments, schedules]: any[] = await Promise.all([api.attendanceSummary(), api.attendance(), api.enrollments(), api.schedule()]); const active = enrollments.filter((item: any) => item.estado === 'Inscrita'); select.innerHTML = active.map((item: any) => `<option value="${item.id}">${item.codigo} · ${item.materia}</option>`).join(''); summaryRoot.innerHTML = summary.length ? summary.map((row: any) => `<article class="surface rounded-2xl p-6"><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${row.codigo}</span><h2 class="mt-2 text-lg font-bold">${row.materia}</h2><p class="mt-1 text-xs text-[#8fa9b5]">${row.periodo}</p><div class="mt-5 flex items-end justify-between"><strong class="text-4xl text-[#e9f1f4]">${row.porcentaje}%</strong><span class="text-xs text-[#8fa9b5]">${row.asistencias}/${row.total} asistencias</span></div><div class="mt-4 h-2 rounded-full bg-[#1e4050]"><div class="h-full rounded-full bg-[#73b8d5]" style="width:${row.porcentaje}%"></div></div></article>`).join('') : '<p class="text-sm text-[#8fa9b5]">Aún no hay resumen de asistencia.</p>'; const groups = active.map((item: any) => ({ item, slots: schedules.filter((schedule: any) => schedule.inscripcion_id === item.id) })).filter(group => group.slots.length); weeklyRoot.innerHTML = groups.length ? groups.map(({ item, slots }) => `<article class="surface-soft rounded-xl p-4"><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${item.codigo}</span><h3 class="mt-2 font-semibold">${item.materia}</h3><div class="mt-3 space-y-2">${slots.map((slot: any) => `<p class="text-sm text-[#a9bbc5]">${slot.dia_semana}: ${String(slot.hora_inicio).slice(0,5)}–${String(slot.hora_fin).slice(0,5)} · Aula ${slot.aula || 'pendiente'}</p>`).join('')}</div></article>`).join('') : '<p class="text-sm text-[#8fa9b5]">Configura primero el horario de tus materias.</p>'; attendanceRoot.innerHTML = attendance.length ? attendance.map((row: any) => `<div class="flex items-center justify-between gap-4 px-6 py-4"><div><strong class="block text-sm">${row.materia}</strong><span class="text-xs text-[#8fa9b5]">${row.fecha_clase.slice(0,10)} · ${row.periodo}</span></div><span class="rounded-full px-3 py-1 text-xs ${row.estado === 'Asistió' ? 'bg-[#1b4a48] text-[#98ded0]' : 'bg-[#4b2933] text-[#f0aaaa]'}">${row.estado}</span></div>`).join('') : '<p class="p-6 text-sm text-[#8fa9b5]">No hay registros de asistencia.</p>' }
  document.querySelector('#attendance-form')?.addEventListener('submit', async event => { event.preventDefault(); const date = (document.querySelector('#attendance-date') as HTMLInputElement).value; if (!date) { message('Selecciona una fecha.', true); return } try { await api.registerAttendance({ inscripcionId: Number(select.value), fechaClase: date, estado: (document.querySelector('#attendance-status') as HTMLSelectElement).value }); message('Asistencia registrada correctamente.'); await load() } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo registrar la asistencia', true) } }); load().catch(() => message('No se pudo cargar la asistencia.', true))
</script>
