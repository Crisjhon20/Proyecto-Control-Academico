---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Compañeros | Control Académico" active="inicio">
  <span class="eyebrow">Comunidad de materia</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Aprender también<br /><span class="text-[#70b6d4]">es compartir.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Selecciona una materia que estés cursando para consultar a tus compañeros.</p><div class="mt-10 max-w-xl"><label class="text-sm text-[#a9bbc5]">Materia<select id="subject-select" class="input-field mt-2"></select></label></div><div id="classmates" class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"></div>
</AppLayout>
<script>
  import { api } from '../../lib/api'; import { requireSession } from '../../lib/session'; requireSession(); const select = document.querySelector<HTMLSelectElement>('#subject-select')!; const root = document.querySelector('#classmates')!
  async function load() { try { if (!select.value) { root.innerHTML = '<p class="text-sm text-[#8fa9b5]">No tienes materias activas.</p>'; return }; const rows: any[] = await api.classmates(Number(select.value)) as any[]; root.innerHTML = rows.length ? rows.map((row: any) => `<article class="surface rounded-2xl p-5"><div class="grid h-11 w-11 place-items-center rounded-full bg-[#1d5368] text-sm font-bold text-[#9bd4e8]">${row.nombres[0]}${row.apellidos[0]}</div><h2 class="mt-4 font-bold">${row.nombres} ${row.apellidos}</h2><a class="mt-3 block text-sm text-[#73b8d5] hover:underline" href="tel:${row.numero_celular}">${row.numero_celular} ↗</a></article>`).join('') : '<p class="text-sm text-[#8fa9b5]">Aún no hay compañeros registrados en esta materia.</p>' } finally { ;(window as any).hidePageLoading?.() } }
  try { const enrollments: any[] = await api.enrollments(); const active = enrollments.filter((item: any) => item.estado === 'Inscrita'); select.innerHTML = active.map((item: any) => `<option value="${item.materia_id}">${item.codigo} · ${item.materia}</option>`).join(''); select.onchange = load; await load() } catch { root.innerHTML = '<p class="text-sm text-[#efaaaa]">No se pudieron cargar tus materias.</p>'; (window as any).hidePageLoading?.() }
</script>
