---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Inicio | Control Académico" active="inicio">
  <section class="flex flex-col justify-between gap-6 md:flex-row md:items-end"><div><span class="eyebrow">Panel del estudiante</span><h1 id="welcome" class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu espacio<br /><span class="text-[#70b6d4]">académico.</span></h1><p class="mt-5 max-w-xl text-sm leading-7 text-[#9db2bd]">Una lectura clara de lo que llevas, lo que viene y lo que ya construiste.</p></div><div id="period-badge" class="rounded-xl border border-[#315667] bg-[#142d3a] px-4 py-3 text-sm text-[#a9bbc5]">Cargando periodo…</div></section>
  <section class="mt-12 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><div class="surface rounded-2xl p-5"><p class="text-xs uppercase tracking-[.12em] text-[#7695a3]">Materias inscritas</p><strong id="stat-subjects" class="mt-3 block text-4xl font-extrabold">—</strong><span class="mt-2 block text-xs text-[#86a4b0]">En tu periodo actual</span></div><div class="surface rounded-2xl p-5"><p class="text-xs uppercase tracking-[.12em] text-[#7695a3]">Créditos</p><strong id="stat-credits" class="mt-3 block text-4xl font-extrabold">—</strong><span class="mt-2 block text-xs text-[#86a4b0]">Carga académica actual</span></div><div class="surface rounded-2xl p-5"><p class="text-xs uppercase tracking-[.12em] text-[#7695a3]">Clases programadas</p><strong id="stat-schedule" class="mt-3 block text-4xl font-extrabold">—</strong><span class="mt-2 block text-xs text-[#86a4b0]">En tu horario</span></div></section>
  <section class="mt-12 grid gap-5 xl:grid-cols-[1.15fr_.85fr]"><div class="surface rounded-2xl p-6"><div class="flex items-center justify-between"><div><span class="eyebrow">Siguiente paso</span><h2 class="mt-5 text-2xl font-bold">Tu próximo horario</h2></div><a href="/app/horario" class="text-sm text-[#73b8d5] hover:underline">Ver horario →</a></div><div id="next-class" class="mt-7"><div class="h-20 animate-pulse rounded-xl bg-[#193746]"></div></div></div><div class="surface rounded-2xl p-6"><span class="eyebrow">Accesos rápidos</span><div class="mt-6 grid gap-3"><a class="surface-soft rounded-xl p-4 transition hover:border-[#73b8d5]" href="/app/inscripciones"><strong class="block">Registrar materias <span class="float-right text-[#73b8d5]">↗</span></strong><small class="mt-1 block text-[#8fa9b5]">Consulta y actualiza tu carga.</small></a><a class="surface-soft rounded-xl p-4 transition hover:border-[#73b8d5]" href="/app/historial"><strong class="block">Revisar historial <span class="float-right text-[#73b8d5]">↗</span></strong><small class="mt-1 block text-[#8fa9b5]">Tus periodos ya cerrados.</small></a></div></div></section>
</AppLayout>
<script>
  import { api } from '../../lib/api'
  import { requireSession } from '../../lib/session'
  const session = requireSession()
  if (session) {
    const welcome = document.querySelector('#welcome'); if (welcome) welcome.innerHTML = `Hola, ${session.student.nombres}.<br /><span class="text-[#70b6d4]">Tu espacio académico.</span>`
    try {
      const period: any = await api.currentPeriod()
       if (!period) {
        document.querySelector('#period-badge')!.textContent = 'Crea tu primer periodo'
        document.querySelector('#stat-subjects')!.textContent = '0'
        document.querySelector('#stat-credits')!.textContent = '0'
        document.querySelector('#stat-schedule')!.textContent = '0'
        document.querySelector('#next-class')!.innerHTML = '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">Crea un periodo desde Inscripciones para comenzar.</p>'
       } else {
       const [enrollments, schedule] = await Promise.all([api.enrollments(period.id), api.schedule(period.id)]) as any[]
      const active = enrollments.filter((item: any) => item.estado === 'Inscrita')
      document.querySelector('#period-badge')!.textContent = `${period.nombre}${period.cerrado ? ' · cerrado' : ' · activo'}`
      document.querySelector('#stat-subjects')!.textContent = String(active.length)
      document.querySelector('#stat-credits')!.textContent = String(active.reduce((sum: number, item: any) => sum + Number(item.creditos || 0), 0))
      document.querySelector('#stat-schedule')!.textContent = String(schedule.length)
      const next = schedule[0]; const target = document.querySelector('#next-class')
       if (target) target.innerHTML = next ? `<div class="flex items-center justify-between rounded-xl border border-[#315667] bg-[#193746] p-5"><div><p class="text-xs uppercase tracking-[.12em] text-[#73b8d5]">${next.dia_semana} · ${String(next.hora_inicio).slice(0,5)}</p><h3 class="mt-2 text-lg font-bold">${next.materia}</h3><p class="mt-1 text-sm text-[#9db2bd]">${next.docente_nombres || 'Docente pendiente'} · Aula ${next.aula || 'pendiente'}</p></div><span class="text-3xl text-[#73b8d5]">→</span></div>` : '<p class="rounded-xl border border-dashed border-[#315667] p-5 text-sm text-[#8fa9b5]">Todavía no tienes horarios configurados.</p>'
       }
    } catch { document.querySelector('#next-class')!.innerHTML = '<p class="text-sm text-[#efaaaa]">No se pudo cargar la información académica.</p>' }
  }
</script>
