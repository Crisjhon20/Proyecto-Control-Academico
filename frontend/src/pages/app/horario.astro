---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Mi horario | Control Académico" active="horario">
  <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><span class="eyebrow">Plan personal</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Construye tu<br /><span class="text-[#70b6d4]">semana.</span></h1><p class="mt-5 max-w-xl text-sm leading-7 text-[#9db2bd]">Asigna docente, aula y horarios a tus materias inscritas. Los cruces se bloquean automáticamente.</p></div></div>
  <p id="schedule-feedback" class="mt-6 hidden rounded-xl border p-4 text-sm"></p>
  <section class="surface mt-8 rounded-2xl p-6"><div class="flex flex-wrap items-center justify-between gap-3"><div><span class="eyebrow">Nueva clase</span><h2 class="mt-4 text-2xl font-bold">Configurar horario</h2></div><button id="teacher-open" class="btn-secondary">+ Registrar docente</button></div><form id="schedule-form" class="mt-6 grid gap-4 lg:grid-cols-6"><label class="text-sm text-[#a9bbc5] lg:col-span-2">Materia inscrita<select id="enrollment-select" class="input-field mt-2" required></select></label><label class="text-sm text-[#a9bbc5]">Docente<select id="teacher-select" class="input-field mt-2" required></select></label><label class="text-sm text-[#a9bbc5]">Aula<select id="classroom-select" class="input-field mt-2" required></select></label><label class="text-sm text-[#a9bbc5]">Día<select id="day-select" class="input-field mt-2"><option>Lunes</option><option>Martes</option><option>Miércoles</option><option>Jueves</option><option>Viernes</option><option>Sábado</option></select></label><label class="text-sm text-[#a9bbc5]">Inicio<input id="start-time" class="input-field mt-2" type="time" min="07:00" max="22:00" step="1800" value="07:00" required /></label><label class="text-sm text-[#a9bbc5]">Finalización<input id="end-time" class="input-field mt-2" type="time" min="07:30" max="22:30" step="1800" value="08:00" required /></label><button class="btn-primary lg:col-span-6" type="submit">Guardar nueva clase ↗</button></form></section>
  <section class="surface mt-6 overflow-hidden rounded-2xl p-6"><div class="flex items-end justify-between"><div><span class="eyebrow">Vista semanal</span><h2 class="mt-4 text-2xl font-bold">Mis clases</h2></div><span class="text-xs text-[#8fa9b5]">07:00 — 22:30</span></div><div id="schedule-grid" class="scrollbar-thin mt-6 overflow-x-auto"></div></section>
  <dialog id="teacher-dialog" class="m-auto w-[min(92vw,460px)] rounded-2xl border border-[#315667] bg-[#102431] p-0 text-[#e9f1f4] backdrop:bg-[#061018]/80"><form id="teacher-form" class="p-6"><div class="flex items-center justify-between"><div><span class="eyebrow">Catálogo personal</span><h2 class="mt-4 text-2xl font-bold">Registrar docente</h2></div><button type="button" id="teacher-close" class="text-2xl text-[#8fa9b5]">×</button></div><div class="mt-6 space-y-4"><input class="input-field" name="nombres" placeholder="Nombres" required /><input class="input-field" name="apellidos" placeholder="Apellidos" required /><button class="btn-primary w-full" type="submit">Guardar docente</button></div></form></dialog>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { scheduleSchema, teacherSchema } from '../../lib/schemas'; import { requireSession } from '../../lib/session'; requireSession()
  const feedback = document.querySelector('#schedule-feedback')!; const enrollmentSelect = document.querySelector<HTMLSelectElement>('#enrollment-select')!; const teacherSelect = document.querySelector<HTMLSelectElement>('#teacher-select')!; const classroomSelect = document.querySelector<HTMLSelectElement>('#classroom-select')!; const grid = document.querySelector('#schedule-grid')!
  const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']; const startMinutes = 7 * 60; const endMinutes = 22 * 60 + 30; const slotHeight = 34
  function message(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-6 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  function timeMinutes(value: string) { const [hours, minutes] = String(value).slice(0, 5).split(':').map(Number); return hours * 60 + minutes }
  function renderGrid(items: any[]) { const totalSlots = (endMinutes - startMinutes) / 30; const labels = Array.from({ length: totalSlots + 1 }, (_, index) => { const minutes = startMinutes + index * 30; return `<span style="top:${index * slotHeight}px" class="absolute left-0 -translate-y-1/2 text-[.62rem] text-[#708e9b]">${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}</span>` }).join(''); grid.innerHTML = `<div class="min-w-[900px]"><div class="grid grid-cols-[64px_repeat(6,1fr)]"><div></div>${days.map(day => `<div class="border-b border-[#315667] p-3 text-center text-xs font-bold text-[#73b8d5]">${day}</div>`).join('')}<div class="relative" style="height:${totalSlots * slotHeight}px">${labels}</div>${days.map(day => { const dayItems = items.filter(item => item.dia_semana === day); const lines = Array.from({ length: totalSlots }, (_, index) => `<div class="border-b border-[#254452]" style="height:${slotHeight}px"></div>`).join(''); const cards = dayItems.map(item => { const top = Math.max(0, timeMinutes(item.hora_inicio) - startMinutes) / 30 * slotHeight; const height = Math.max(slotHeight / 2, (timeMinutes(item.hora_fin) - timeMinutes(item.hora_inicio)) / 30 * slotHeight); return `<article class="absolute left-1 right-1 overflow-hidden rounded-lg border border-[#43829a] bg-[#1d5368] p-2 text-[.65rem] leading-4 shadow-lg" style="top:${top}px;height:${height}px"><strong class="block">${item.codigo} · ${item.materia}</strong><span class="block">${String(item.hora_inicio).slice(0, 5)}–${String(item.hora_fin).slice(0, 5)}</span><span class="block">${item.docente_nombres || ''} ${item.docente_apellidos || ''}</span><span class="block">${item.aula || 'Aula'}</span><button data-delete="${item.id}" class="mt-1 text-[#bfe6f1] underline">quitar</button></article>` }).join(''); return `<div class="relative border-l border-[#254452]" style="height:${totalSlots * slotHeight}px">${lines}${cards}</div>` }).join('')}</div></div>`; grid.querySelectorAll<HTMLElement>('[data-delete]').forEach(button => button.onclick = async () => { try { await api.deleteSchedule(Number(button.dataset.delete)); await load() } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo quitar la clase', true) } }) }
  async function load() { try { const current: any = await api.currentPeriod(); if (!current) { message('Crea un periodo desde Inscripciones antes de configurar tu horario.'); return } const [allEnrollments, teachers, classrooms, schedules]: any[] = await Promise.all([api.enrollments(current.id), api.teachers(), api.classrooms(), api.schedule(current.id)]); const enrollments = allEnrollments.filter((item: any) => item.estado === 'Inscrita'); enrollmentSelect.innerHTML = enrollments.map((item: any) => `<option value="${item.id}">${item.codigo} · ${item.materia}</option>`).join(''); teacherSelect.innerHTML = teachers.map((item: any) => `<option value="${item.id}">${item.nombres} ${item.apellidos}</option>`).join(''); classroomSelect.innerHTML = classrooms.map((item: any) => `<option value="${item.id}">${item.etiqueta || `Aula ${item.numero}`}</option>`).join(''); renderGrid(schedules) } finally { ;(window as any).hidePageLoading?.() } }
  document.querySelector('#schedule-form')?.addEventListener('submit', async event => { event.preventDefault(); const input = { docenteId: Number(teacherSelect.value), aulaId: Number(classroomSelect.value), diaSemana: (document.querySelector('#day-select') as HTMLSelectElement).value, horaInicio: (document.querySelector('#start-time') as HTMLInputElement).value, horaFin: (document.querySelector('#end-time') as HTMLInputElement).value }; const parsed = scheduleSchema.safeParse(input); if (!parsed.success) { message(parsed.error.issues[0]?.message || 'Revisa el horario', true); return } try { await api.createSchedule(Number(enrollmentSelect.value), parsed.data); message('Horario guardado correctamente.'); await load() } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo guardar el horario', true) } })
  const dialog = document.querySelector<HTMLDialogElement>('#teacher-dialog')!; document.querySelector('#teacher-open')?.addEventListener('click', () => dialog.showModal()); document.querySelector('#teacher-close')?.addEventListener('click', () => dialog.close()); document.querySelector('#teacher-form')?.addEventListener('submit', async event => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const parsed = teacherSchema.safeParse(Object.fromEntries(new FormData(form).entries())); if (!parsed.success) { message(parsed.error.issues[0]?.message || 'Revisa el docente', true); return } try { const teacher: any = await api.createTeacher(parsed.data); teacherSelect.add(new Option(`${teacher.nombres} ${teacher.apellidos}`, String(teacher.id), true, true)); dialog.close(); form.reset(); message('Docente registrado en tu catálogo personal.') } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo registrar el docente', true) } })
  load().catch(error => { message(error instanceof ApiError ? error.message : 'No se pudo cargar tu horario', true); (window as any).hidePageLoading?.() })
</script>
