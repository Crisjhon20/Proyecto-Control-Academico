---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Historial académico | Control Académico" active="historial">
  <span class="eyebrow">Trayectoria</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu historial<br /><span class="text-[#70b6d4]">académico.</span></h1><p class="mt-5 max-w-2xl text-sm leading-7 text-[#9db2bd]">Registra materias cursadas anteriormente y consulta los resultados guardados al cerrar tus periodos.</p>
  <p id="history-feedback" class="mt-6 hidden rounded-xl border p-4 text-sm"></p>
  <details class="surface mt-8 rounded-2xl p-6"><summary class="cursor-pointer list-none"><span class="eyebrow">Carga inicial</span><h2 class="mt-4 text-2xl font-bold">Agregar materia cursada</h2><p class="mt-2 text-sm text-[#8fa9b5]">Registra materias aprobadas o reprobadas antes de usar la plataforma.</p><p class="details-closed-hint mt-3 text-xs text-[#73b8d5]">Presiona para abrir el apartado.</p><p class="details-open-hint mt-3 text-xs text-[#73b8d5]">Presiona para cerrar el apartado.</p></summary><form id="history-form" class="mt-6 grid gap-4 md:grid-cols-3"><label class="text-sm text-[#a9bbc5] md:col-span-2">Materia<select id="history-subject" class="input-field mt-2" required></select></label><label class="text-sm text-[#a9bbc5]">Semestre cursado<input id="history-semester" class="input-field mt-2" type="number" min="1" max="20" required /></label><label class="text-sm text-[#a9bbc5]">Nota final<input id="history-grade" class="input-field mt-2" type="number" min="0" max="100" step="0.01" required /></label><div class="flex items-end gap-3"><button class="btn-primary" type="submit">Guardar historial</button><button id="history-cancel" class="btn-secondary hidden" type="button">Cancelar</button></div></form></details>
  <div id="history" class="mt-8 overflow-hidden rounded-2xl border border-[#315667] bg-[#142d3a]"></div>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { requireSession } from '../../lib/session'; requireSession()
  const root = document.querySelector('#history')!; const feedback = document.querySelector('#history-feedback')!; const form = document.querySelector<HTMLFormElement>('#history-form')!; const subject = document.querySelector<HTMLSelectElement>('#history-subject')!; const semester = document.querySelector<HTMLInputElement>('#history-semester')!; const grade = document.querySelector<HTMLInputElement>('#history-grade')!; const cancel = document.querySelector<HTMLButtonElement>('#history-cancel')!; let editingId: number | null = null; let historyRows: any[] = []
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' } as any)[character] || character)
  function message(text: string, bad = false) { feedback.textContent = text; feedback.className = `mt-6 rounded-xl border p-4 text-sm ${bad ? 'border-[#70434a] bg-[#321f29] text-[#efaaaa]' : 'border-[#396b7d] bg-[#183947] text-[#a9dbea]'}` }
  function allSubjects(curriculum: any[]) { return curriculum.flatMap(career => career.semestres.flatMap((item: any) => item.materias)) }
  function render() { root.innerHTML = historyRows.length ? `<div class="hidden grid-cols-[1.4fr_.7fr_.7fr_.7fr_auto] border-b border-[#315667] px-6 py-4 text-xs font-bold uppercase tracking-[.1em] text-[#7394a1] sm:grid"><span>Materia</span><span>Semestre</span><span>Origen</span><span>Nota</span><span></span></div>${historyRows.map(row => `<div class="grid gap-3 border-b border-[#294b5a] px-6 py-5 last:border-0 sm:grid-cols-[1.4fr_.7fr_.7fr_.7fr_auto] sm:items-center"><div><span class="text-xs font-bold tracking-[.1em] text-[#73b8d5]">${escapeHtml(row.codigo)}</span><strong class="mt-1 block">${escapeHtml(row.materia)}</strong><small class="text-[#8fa9b5]">${row.periodo ? `Periodo ${escapeHtml(row.periodo)}` : 'Registro manual'} · ${escapeHtml(row.creditos)} créditos</small></div><span class="text-sm text-[#a9bbc5]">${escapeHtml(row.semestre_cursado)}</span><span class="text-sm text-[#a9bbc5]">${escapeHtml(row.origen)}</span><strong class="text-xl text-[#e9f1f4]">${escapeHtml(row.nota_final)} <small class="text-xs text-[#8fa9b5]">${escapeHtml(row.estado)}</small></strong>${row.origen === 'Manual' ? `<div class="flex gap-3"><button data-edit="${row.id}" class="text-sm text-[#73b8d5] underline">Editar</button><button data-delete="${row.id}" class="text-sm text-[#ef9a9a] underline">Eliminar</button></div>` : '<span></span>'}</div>`).join('')}` : '<div class="p-8 text-sm text-[#8fa9b5]">Todavía no hay registros académicos.</div>'; bindActions() }
  function resetForm() { editingId = null; form.reset(); cancel.classList.add('hidden') }
  function bindActions() { root.querySelectorAll<HTMLElement>('[data-delete]').forEach(button => button.onclick = async () => { if (!confirm('¿Eliminar este registro manual?')) return; try { await api.deleteManualHistory(Number(button.dataset.delete)); historyRows = historyRows.filter(row => row.id !== Number(button.dataset.delete)); render(); message('Registro eliminado correctamente.') } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo eliminar el registro', true) } }); root.querySelectorAll<HTMLElement>('[data-edit]').forEach(button => button.onclick = () => { const row = historyRows.find(item => item.id === Number(button.dataset.edit)); if (!row) return; editingId = row.id; subject.value = String(row.materia_id); semester.value = String(row.semestre_cursado); grade.value = String(row.nota_final); cancel.classList.remove('hidden'); document.querySelector('#history-form')?.scrollIntoView({ behavior: 'smooth', block: 'center' }) }) }
  try { const [rows, curriculum]: any[] = await Promise.all([api.history(), api.curriculum()]); historyRows = rows; subject.innerHTML = allSubjects(curriculum).map((item: any) => `<option value="${item.id}">${escapeHtml(item.codigo)} · ${escapeHtml(item.nombre)}</option>`).join(''); render() } catch { message('No se pudo cargar el historial', true) } finally { ;(window as any).hidePageLoading?.() }
  form.addEventListener('submit', async event => { event.preventDefault(); const data = { materiaId: Number(subject.value), semestreCursado: Number(semester.value), notaFinal: Number(grade.value) }; if (!data.materiaId || data.semestreCursado < 1 || data.semestreCursado > 20 || data.notaFinal < 0 || data.notaFinal > 100) { message('Revisa los datos del historial', true); return } try { if (editingId) await api.updateManualHistory(editingId, data); else await api.createManualHistory(data); const rows: any[] = await api.history() as any[]; historyRows = rows; render(); resetForm(); message('Historial guardado correctamente.') } catch (error) { message(error instanceof ApiError ? error.message : 'No se pudo guardar el historial', true) } })
  cancel.addEventListener('click', resetForm)
</script>
