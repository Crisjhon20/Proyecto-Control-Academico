---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Perfil | Control Académico" active="inicio">
  <span class="eyebrow">Tu identidad académica</span>
  <h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu perfil,<br /><span class="text-[#70b6d4]">siempre contigo.</span></h1>
  <div class="mt-10 grid max-w-4xl gap-6 lg:grid-cols-[minmax(220px,280px)_1fr]">
    <section class="surface rounded-2xl p-6 sm:p-8" aria-labelledby="photo-title">
      <h2 id="photo-title" class="text-lg font-bold text-[#e9f1f4]">Foto de perfil</h2>
      <div class="mt-6 flex justify-center">
        <div class="grid h-40 w-40 place-items-center overflow-hidden rounded-full border border-[#427487] bg-[#193b4b] text-4xl font-bold text-[#8ed2eb]">
          <span id="photo-fallback" aria-hidden="true">CA</span>
          <img id="profile-photo-preview" class="hidden h-full w-full object-cover" alt="Vista previa de la foto de perfil" />
        </div>
      </div>
      <form id="photo-form" class="mt-6 grid gap-3">
        <label class="text-sm text-[#a9bbc5]" for="photo-input">Seleccionar imagen</label>
        <input id="photo-input" class="input-field text-sm" type="file" accept="image/*" />
        <p class="text-xs leading-5 text-[#819ba7]">Se acepta cualquier imagen compatible. Tamaño original máximo: 10 MB. Se comprimirá automáticamente.</p>
        <p id="photo-feedback" class="hidden rounded-lg p-3 text-sm" role="status"></p>
        <button id="photo-submit" class="btn-secondary" type="submit">Guardar foto</button>
      </form>
    </section>
    <div class="surface rounded-2xl p-6 sm:p-8">
      <form id="profile-form" class="grid gap-5 sm:grid-cols-2">
        <label class="text-sm text-[#a9bbc5]">Nombres<input class="input-field mt-2" name="nombres" /></label>
        <label class="text-sm text-[#a9bbc5]">Apellidos<input class="input-field mt-2" name="apellidos" /></label>
        <label class="text-sm text-[#a9bbc5] sm:col-span-2">Número de celular<input class="input-field mt-2" name="numeroCelular" /></label>
        <label class="text-sm text-[#a9bbc5] sm:col-span-2">Nueva contraseña<input class="input-field mt-2" type="password" name="contrasena" placeholder="Déjala vacía para mantenerla" /></label>
        <p id="profile-feedback" class="hidden sm:col-span-2 rounded-lg p-3 text-sm"></p>
        <button class="btn-primary sm:col-span-2" type="submit">Guardar cambios</button>
      </form>
    </div>
  </div>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'
  import { profileSchema } from '../../lib/schemas'
  import { requireSession } from '../../lib/session'

  const session = requireSession()
  const form = document.querySelector<HTMLFormElement>('#profile-form')!
  const feedback = document.querySelector('#profile-feedback')!
  const photoForm = document.querySelector<HTMLFormElement>('#photo-form')!
  const photoInput = document.querySelector<HTMLInputElement>('#photo-input')!
  const photoPreview = document.querySelector<HTMLImageElement>('#profile-photo-preview')!
  const photoFallback = document.querySelector('#photo-fallback')!
  const photoFeedback = document.querySelector('#photo-feedback')!
  const photoSubmit = document.querySelector<HTMLButtonElement>('#photo-submit')!
  const maxSourcePhotoBytes = 10 * 1024 * 1024
  let previewUrl = ''

  const showPhoto = (url: string) => {
    photoPreview.src = url
    photoPreview.classList.remove('hidden')
    photoFallback.classList.add('hidden')
  }

  const setPhotoFeedback = (message: string, error = false) => {
    photoFeedback.textContent = message
    photoFeedback.className = error
      ? 'rounded-lg border border-[#70434a] bg-[#321f29] p-3 text-sm text-[#efaaaa]'
      : 'rounded-lg border border-[#396b7d] bg-[#183947] p-3 text-sm text-[#a9dbea]'
  }

  const compressImage = async (file: File) => {
    const bitmap = await createImageBitmap(file)
    const scale = Math.min(1, 800 / bitmap.width, 800 / bitmap.height)
    const canvas = document.createElement('canvas')
    canvas.width = Math.max(1, Math.round(bitmap.width * scale))
    canvas.height = Math.max(1, Math.round(bitmap.height * scale))
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height)
    bitmap.close()

    for (const quality of [0.82, 0.7, 0.55]) {
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', quality))
      if (blob && blob.size <= 2 * 1024 * 1024) return new File([blob], 'profile.webp', { type: 'image/webp' })
    }
    throw new Error('No se pudo comprimir la imagen por debajo de 2 MB')
  }

  const profile: any = await api.profile()
  form.nombres.value = profile.nombres || ''
  form.apellidos.value = profile.apellidos || ''
  form.numeroCelular.value = profile.numeroCelular || ''
  if (session) photoFallback.textContent = session.student.nombres.slice(0, 1) + session.student.apellidos.slice(0, 1)
  api.profilePhoto().then((blob) => showPhoto(URL.createObjectURL(blob))).catch(() => {})

  photoInput.addEventListener('change', () => {
    const file = photoInput.files?.[0]
    if (!file) return
    if (!file.type.startsWith('image/') || file.size > maxSourcePhotoBytes) {
      photoInput.value = ''
      setPhotoFeedback('Selecciona una imagen válida de máximo 10 MB.', true)
      return
    }
    if (previewUrl) URL.revokeObjectURL(previewUrl)
    previewUrl = URL.createObjectURL(file)
    showPhoto(previewUrl)
    photoFeedback.className = 'hidden'
  })

  photoForm.addEventListener('submit', async (event) => {
    event.preventDefault()
    const file = photoInput.files?.[0]
    if (!file) return setPhotoFeedback('Selecciona una imagen antes de guardar.', true)
    photoSubmit.disabled = true
    setPhotoFeedback('Comprimiendo imagen...')
    try {
      const compressed = await compressImage(file)
      const result: any = await api.uploadProfilePhoto(compressed)
      const sizeInKb = Math.max(1, Math.round((result.size || compressed.size) / 1024))
      setPhotoFeedback(`Foto actualizada. Tamaño final: ${sizeInKb} KB.`)
    } catch (error) {
      setPhotoFeedback(error instanceof ApiError ? error.message : 'No se pudo guardar la foto.', true)
    } finally {
      photoSubmit.disabled = false
    }
  })

  form.addEventListener('submit', async event => {
    event.preventDefault()
    const data = Object.fromEntries(new FormData(form).entries())
    if (!data.contrasena) delete data.contrasena
    const parsed = profileSchema.safeParse(data)
    if (!parsed.success) {
      feedback.textContent = parsed.error.issues[0]?.message || 'Revisa los datos'
      feedback.className = 'sm:col-span-2 rounded-lg border border-[#70434a] bg-[#321f29] p-3 text-sm text-[#efaaaa]'
      return
    }
    try {
      await api.updateProfile(parsed.data)
      feedback.textContent = 'Perfil actualizado correctamente.'
      feedback.className = 'sm:col-span-2 rounded-lg border border-[#396b7d] bg-[#183947] p-3 text-sm text-[#a9dbea]'
    } catch (error) {
      feedback.textContent = error instanceof ApiError ? error.message : 'No se pudo guardar'
      feedback.className = 'sm:col-span-2 rounded-lg border border-[#70434a] bg-[#321f29] p-3 text-sm text-[#efaaaa]'
    }
  })
</script>
