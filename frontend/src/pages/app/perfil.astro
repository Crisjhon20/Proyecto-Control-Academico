---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Perfil | Control Académico" active="inicio">
  <span class="eyebrow">Tu identidad académica</span><h1 class="display mt-6 text-5xl font-extrabold sm:text-6xl">Tu perfil,<br /><span class="text-[#70b6d4]">siempre contigo.</span></h1><div class="mt-10 max-w-2xl surface rounded-2xl p-6 sm:p-8"><form id="profile-form" class="grid gap-5 sm:grid-cols-2"><label class="text-sm text-[#a9bbc5]">Nombres<input class="input-field mt-2" name="nombres" /></label><label class="text-sm text-[#a9bbc5]">Apellidos<input class="input-field mt-2" name="apellidos" /></label><label class="text-sm text-[#a9bbc5] sm:col-span-2">Número de celular<input class="input-field mt-2" name="numeroCelular" /></label><label class="text-sm text-[#a9bbc5] sm:col-span-2">Nueva contraseña<input class="input-field mt-2" type="password" name="contrasena" placeholder="Déjala vacía para mantenerla" /></label><p id="profile-feedback" class="hidden sm:col-span-2 rounded-lg p-3 text-sm"></p><button class="btn-primary sm:col-span-2" type="submit">Guardar cambios</button></form></div>
</AppLayout>
<script>
  import { api, ApiError } from '../../lib/api'; import { profileSchema } from '../../lib/schemas'; import { requireSession } from '../../lib/session'; requireSession(); const form = document.querySelector<HTMLFormElement>('#profile-form')!; const feedback = document.querySelector('#profile-feedback')!
  const profile: any = await api.profile(); form.nombres.value = profile.nombres || ''; form.apellidos.value = profile.apellidos || ''; form.numeroCelular.value = profile.numeroCelular || ''
  form.addEventListener('submit', async event => { event.preventDefault(); const data = Object.fromEntries(new FormData(form).entries()); if (!data.contrasena) delete data.contrasena; const parsed = profileSchema.safeParse(data); if (!parsed.success) { feedback.textContent = parsed.error.issues[0]?.message || 'Revisa los datos'; feedback.className = 'sm:col-span-2 rounded-lg border border-[#70434a] bg-[#321f29] p-3 text-sm text-[#efaaaa]'; return } try { await api.updateProfile(parsed.data); feedback.textContent = 'Perfil actualizado correctamente.'; feedback.className = 'sm:col-span-2 rounded-lg border border-[#396b7d] bg-[#183947] p-3 text-sm text-[#a9dbea]' } catch (e) { feedback.textContent = e instanceof ApiError ? e.message : 'No se pudo guardar'; feedback.className = 'sm:col-span-2 rounded-lg border border-[#70434a] bg-[#321f29] p-3 text-sm text-[#efaaaa]' } })
</script>
